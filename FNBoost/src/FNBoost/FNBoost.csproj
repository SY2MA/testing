<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FNBoost</RootNamespace>
    <AssemblyName>FNBoost</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fnboost.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>FN Boost</Product>
    <Description>Ottimizzatore sicuro per Windows 11 + crosshair overlay per Fortnite</Description>
    <Copyright>FN Boost</Copyright>
    <!-- Permette di compilare anche da Linux/macOS (CI); l'app gira solo su Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WPF gestisce il DPI dal manifest: l'avviso WinForms qui non si applica. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- Lettura degli eventi ETW "Present" (stesso metodo di PresentMon / Xbox Game Bar) per il contatore FPS. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
  </ItemGroup>

  <!-- TraceEvent copia DLL native (KernelTraceControl, msdia140) servono solo per trace del kernel/simboli:
       la sessione real-time usata qui non le richiede, quindi si escludono per mantenere un exe singolo. -->
  <Target Name="FNBoostRemoveTraceEventNatives" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.Identity)').Contains('microsoft.diagnostics.tracing.traceevent'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\fnboost.png" />
    <Resource Include="Assets\fnboost.ico" />
  </ItemGroup>

</Project>
