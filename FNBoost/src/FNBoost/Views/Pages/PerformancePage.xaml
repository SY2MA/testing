<UserControl x:Class="FNBoost.Views.Pages.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:perf="clr-namespace:FNBoost.Perf">
    <UserControl.Resources>
        <!-- Titolo di una card -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Valore mostrato a destra degli slider -->
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <!-- Riquadri dei numeri dal vivo -->
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SysValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Barra di utilizzo (riempita da codice con ScaleX 0..1) -->
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
        <!-- Osservazioni dell'analisi (stesso stile dei controlli della Panoramica) -->
        <DataTemplate x:Key="InsightTemplate">
            <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                            Background="{Binding Severity, Converter={StaticResource StatusToBrush}}" Opacity="0.18" />
                    <TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="Bold" Width="26" TextAlignment="Center"
                               VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left"
                               Foreground="{Binding Severity, Converter={StaticResource StatusToBrush}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.9" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Small}" Margin="0,4,0,0"
                                   Visibility="{Binding Hint, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Prestazioni" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                       Text="Contatore FPS con 1% low, 0,1% low, minimo, massimo e media, più l'analisi delle tue partite nel tempo. Gli FPS si misurano dagli eventi «Present» di Windows (ETW), lo stesso metodo di PresentMon e del contatore della Xbox Game Bar: FN Boost osserva solo il sistema e non tocca il gioco (niente iniezioni, hook o lettura della memoria)." />

            <!-- ===================== Stato e registrazione ===================== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="RecBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#33FF5D6C"
                                Margin="12,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="RecBadgeText" Style="{StaticResource BadgeText}" Foreground="{StaticResource BadBrush}"
                                       FontWeight="SemiBold" Text="● REC" />
                        </Border>
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLine" Margin="10,0,0,0" FontWeight="SemiBold" Text="…" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="ProcessLine" Style="{StaticResource Small}" Margin="20,4,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="RecordBtn" Style="{StaticResource AccentButton}" Click="Record_Click" Padding="16,8" Margin="0,0,8,6"
                                MinWidth="200">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RecordIcon" Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock x:Name="RecordText" Text="Avvia registrazione" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetBtn" Click="Reset_Click" Padding="14,8" Margin="0,0,16,6"
                                ToolTip="Azzera finestra mobile, minimo, massimo e grafici dal vivo (le sessioni salvate non vengono toccate)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Azzera statistiche" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Etichetta" Style="{StaticResource Label}" Margin="0,0,8,6" />
                        <TextBox x:Name="LabelBox" Width="220" Margin="0,0,0,6" MaxLength="60"
                                 ToolTip="Nome della prossima registrazione (es. «dopo tweak», «DX12», «Performance mode»). Serve anche per rinominare una sessione dello storico." />
                    </WrapPanel>
                    <TextBlock x:Name="RecordHint" Style="{StaticResource Small}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ===================== Numeri dal vivo ===================== -->
            <UniformGrid Columns="5" Margin="0,0,-10,0">
                <Border Style="{StaticResource Tile}" ToolTip="FPS dell'ultimo secondo.">
                    <StackPanel>
                        <TextBlock Text="FPS ORA" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="FpsNowText" Style="{StaticResource TileValue}" Foreground="{StaticResource Accent2Brush}" Text="–" />
                        <TextBlock Text="ultimo secondo" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="Frame totali divisi per il tempo della finestra mobile: la media reale.">
                    <StackPanel>
                        <TextBlock Text="MEDIA" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="AvgText" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock x:Name="WindowSub" Text="finestra mobile" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}"
                        ToolTip="1% low: media dell'1% dei frame più lenti, in FPS. È la fluidità nei momenti peggiori: più è vicino alla media, meglio è.">
                    <StackPanel>
                        <TextBlock Text="1% LOW" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="Low1Text" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock x:Name="Low1Sub" Text="frame più lenti" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}"
                        ToolTip="0,1% low: come l'1% low ma sullo 0,1% dei frame più lenti. Cattura gli scatti rari e più fastidiosi.">
                    <StackPanel>
                        <TextBlock Text="0,1% LOW" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="Low01Text" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock Text="scatti rari" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}"
                        ToolTip="Consistenza 0-100: quanto sono regolari i frametime (100 = perfettamente costanti). Conta più degli FPS medi per la sensazione di fluidità.">
                    <StackPanel>
                        <TextBlock Text="CONSISTENZA" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="ConsText" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock Text="su 100" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="FPS minimi: calcolati dal frame più lento della finestra (1000 / frametime massimo).">
                    <StackPanel>
                        <TextBlock Text="MIN" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="MinText" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock Text="frame più lento" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="FPS massimi: calcolati dal frame più veloce della finestra (1000 / frametime minimo).">
                    <StackPanel>
                        <TextBlock Text="MAX" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="MaxText" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock Text="frame più veloce" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="Frametime: quanti millisecondi ha richiesto l'ultimo frame (16,7 ms = 60 FPS, 4,2 ms = 240 FPS).">
                    <StackPanel>
                        <TextBlock Text="FRAMETIME" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="FtText" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock x:Name="FtSub" Text="ultimo frame" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}"
                        ToolTip="Stutter al minuto: frame che durano molto più dei vicini (la soglia si regola in «Sensibilità stutter»).">
                    <StackPanel>
                        <TextBlock Text="STUTTER/MIN" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="StutterText" Style="{StaticResource TileValue}" Text="–" />
                        <TextBlock x:Name="StutterSub" Text="scatti" Style="{StaticResource TileSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="Processo misurato (nome e PID dall'elenco processi di Windows).">
                    <StackPanel>
                        <TextBlock Text="GIOCO" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="GameText" Style="{StaticResource TileValue}" FontSize="17" Margin="0,10,0,0" Text="–" />
                        <TextBlock x:Name="GameSub" Style="{StaticResource TileSub}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Sistema -->
            <UniformGrid Columns="4" Margin="0,0,-10,0">
                <Border Style="{StaticResource Tile}" ToolTip="Utilizzo totale del processore.">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="CpuText" Style="{StaticResource SysValue}" Text="–" />
                        <Border Style="{StaticResource BarTrack}">
                            <Border Style="{StaticResource BarFill}" Background="{StaticResource AccentBrush}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CpuScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="Utilizzo del motore 3D della scheda video (contatori di Windows).">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="GpuText" Style="{StaticResource SysValue}" Text="–" />
                        <Border Style="{StaticResource BarTrack}">
                            <Border Style="{StaticResource BarFill}" Background="{StaticResource OkBrush}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="GpuScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="Memoria di sistema in uso.">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="RamText" Style="{StaticResource SysValue}" Text="–" />
                        <Border Style="{StaticResource BarTrack}">
                            <Border Style="{StaticResource BarFill}" Background="{StaticResource InfoBrush}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RamScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" ToolTip="Memoria video in uso (dedicata).">
                    <StackPanel>
                        <TextBlock Text="VRAM" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="VramText" Style="{StaticResource SysValue}" Text="–" />
                        <Border Style="{StaticResource BarTrack}">
                            <Border Style="{StaticResource BarFill}" Background="{StaticResource WarnBrush}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="VramScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Grafici dal vivo -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center"
                                       Text="giallo = scatto · rosso = oltre 50 ms" />
                            <TextBlock Text="Frametime (ultimi frame)" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <perf:FrametimeGraph x:Name="FtGraph" Height="170" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FPS nel tempo" Style="{StaticResource CardTitle}" />
                        <perf:LineChart x:Name="FpsChart" Height="170" Margin="0,10,0,0" XLabel="ultimi 120 secondi" Legend="FPS al secondo" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Misurazione ===================== -->
            <TextBlock Text="Impostazioni" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Misurazione" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox x:Name="CaptureToggle" Style="{StaticResource ToggleSwitch}" Click="PerfSetting_Click"
                                      Content="Misura gli FPS in background" />
                            <TextBlock Style="{StaticResource Small}" Margin="54,4,0,0"
                                       Text="Consumo minimo: legge solo gli eventi di sistema. Spegnilo se non ti serve." />
                            <CheckBox x:Name="AutoRecordToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" Click="PerfSetting_Click"
                                      Content="Registra automaticamente le partite" />
                            <TextBlock Style="{StaticResource Small}" Margin="54,4,0,0"
                                       Text="Parte quando il gioco renderizza da qualche secondo e si ferma quando smette: ogni partita finisce nello storico." />
                            <TextBlock x:Name="RecordHotkeyHint" Style="{StaticResource Small}" Margin="0,14,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gioco da misurare" Style="{StaticResource Label}" />
                                <ComboBox x:Name="TargetCombo" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectionChanged="PerfSetting_Changed" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Finestra statistiche" Style="{StaticResource Label}"
                                           ToolTip="Su quanti secondi recenti si calcolano media, 1% low, minimo e massimo dal vivo." />
                                <ComboBox x:Name="WindowCombo" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectionChanged="PerfSetting_Changed" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Durata minima sessione" Style="{StaticResource Label}"
                                           ToolTip="Le registrazioni più corte non vengono salvate nello storico." />
                                <ComboBox x:Name="MinSessionCombo" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectionChanged="PerfSetting_Changed" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sensibilità stutter" Style="{StaticResource Label}" />
                                <Slider x:Name="StutterSlider" Grid.Column="1" Minimum="1.5" Maximum="4" TickFrequency="0.25"
                                        IsSnapToTickEnabled="True" Value="2.5" ValueChanged="Stutter_ValueChanged" />
                                <TextBlock x:Name="StutterValue" Grid.Column="2" Style="{StaticResource Value}" Text="2,5×" />
                            </Grid>
                            <TextBlock Style="{StaticResource Small}"
                                       Text="Un frame è uno «stutter» se dura più di questo multiplo dei frame vicini (e almeno 12 ms). Valori bassi = più sensibile." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Overlay FPS in gioco ===================== -->
            <Border x:Name="OverlayCard" Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}">
                        <TextBlock Text="Overlay FPS in gioco" FontWeight="SemiBold" FontSize="15" />
                    </CheckBox>
                    <TextBlock x:Name="OverlayHotkeyHint" Style="{StaticResource Small}" Margin="54,6,0,0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Posizione e aspetto -->
                        <StackPanel>
                            <TextBlock Text="Posizione e aspetto" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Angolo" Style="{StaticResource Label}" />
                                <ComboBox x:Name="CornerCombo" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Corner}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Monitor" Style="{StaticResource Label}" />
                                <ComboBox x:Name="MonitorCombo" Grid.Column="1" SelectedValuePath="Device" DisplayMemberPath="Label"
                                          SelectedValue="{Binding Monitor}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distanza X" Style="{StaticResource Label}" ToolTip="Distanza orizzontale dal bordo (pixel reali)." />
                                <Slider Grid.Column="1" Minimum="0" Maximum="400" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding OffsetX}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding OffsetX}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distanza Y" Style="{StaticResource Label}" ToolTip="Distanza verticale dal bordo (pixel reali)." />
                                <Slider Grid.Column="1" Minimum="0" Maximum="400" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding OffsetY}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding OffsetY}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione testo" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" Minimum="9" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding FontSize}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding FontSize, StringFormat={}{0:0}}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacità sfondo" Style="{StaticResource Label}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                        Value="{Binding BackgroundOpacity}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Colore testo" Style="{StaticResource Label}" />
                                <TextBox Grid.Column="1" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                         MaxLength="9" ToolTip="Colore esadecimale, es. #FFFFFF" />
                                <WrapPanel x:Name="TextSwatches" Grid.Column="2" Margin="10,6,0,0" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Colore FPS" Style="{StaticResource Label}" />
                                <TextBox Grid.Column="1" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                         MaxLength="9" ToolTip="Colore esadecimale del numero FPS e del mini grafico, es. #00E5FF" />
                                <WrapPanel x:Name="AccentSwatches" Grid.Column="2" Margin="10,6,0,0" />
                            </Grid>
                        </StackPanel>
                        <!-- Cosa mostrare -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cosa mostrare" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <CheckBox IsChecked="{Binding ShowFps}" Content="FPS attuali (grande)" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding ShowAvg}" Content="Media" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding Show1Low}" Content="1% low" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding Show01Low}" Content="0,1% low" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding ShowMinMax}" Content="Minimo e massimo" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding ShowFrametime}" Content="Frametime (ms)" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding ShowCpuGpu}" Content="Utilizzo CPU e GPU" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding ShowGraph}" Content="Mini grafico dei frametime" Margin="0,0,0,8" />
                            <Separator Margin="0,6,0,12" Background="{StaticResource BorderBrush}" />
                            <CheckBox IsChecked="{Binding Compact}" Content="Compatto (una sola riga)" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding OnlyWhenGameFocused}" Content="Mostra solo con il gioco in primo piano" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Small}" Margin="26,0,0,0"
                                       Text="Mentre FN Boost è in primo piano l'overlay resta visibile, così vedi subito le modifiche." />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0"
                               Text="L'overlay è una finestra trasparente di FN Boost che i clic attraversano, come quella del mirino: funziona in finestra a schermo intero o senza bordi, non nel vero schermo intero esclusivo." />
                </StackPanel>
            </Border>

            <!-- ===================== Storico sessioni ===================== -->
            <TextBlock Text="Analisi nel tempo" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="OpenFolder_Click" Padding="12,6"
                                ToolTip="Apri la cartella con i file delle sessioni">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                                <TextBlock Text="Apri cartella" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Storico sessioni" Style="{StaticResource CardTitle}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"
                               Text="Le partite registrate restano solo su questo PC. Seleziona una sessione per l'analisi completa, oppure confronta prima e dopo un tweak." />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <ListBox x:Name="SessionList" Height="276" SelectionChanged="SessionList_SelectionChanged"
                                         MouseDoubleClick="SessionList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AvgText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource Accent2Brush}" />
                                                    <TextBlock Text="{Binding LowText}" Style="{StaticResource Small}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="EmptySessionsText" Style="{StaticResource Muted}" Margin="18" VerticalAlignment="Center"
                                           TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                           Text="Nessuna sessione salvata. Gioca una partita con la registrazione automatica attiva, oppure premi «Avvia registrazione»." />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="AnalyzeBtn" Style="{StaticResource AccentButton}" Click="Analyze_Click" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13" />
                                        <TextBlock Text="Analizza" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RenameBtn" Content="Rinomina" Click="Rename_Click" Margin="0,0,8,6"
                                        ToolTip="Scrivi il nuovo nome nel campo «Etichetta» in alto, poi premi Rinomina" />
                                <Button x:Name="ExportBtn" Content="Esporta CSV" Click="Export_Click" Margin="0,0,8,6"
                                        ToolTip="Salva tutti i frametime della sessione (indice, tempo, frametime, FPS) per Excel o altri strumenti" />
                                <Button x:Name="DeleteBtn" Content="Elimina" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,6" />
                            </WrapPanel>
                            <TextBlock x:Name="SessionHint" Style="{StaticResource Small}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Andamento tra le sessioni" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="TrendSub" Style="{StaticResource Small}" Margin="0,2,0,0" />
                            <perf:LineChart x:Name="TrendChart" Height="230" Margin="0,10,0,0" Legend="FPS medi" Legend2="1% low"
                                            XLabel="sessioni, dalla più vecchia" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="TrendList" Margin="0,14,0,0" ItemTemplate="{StaticResource InsightTemplate}" />
                </StackPanel>
            </Border>

            <!-- ===================== Analisi sessione ===================== -->
            <Border x:Name="AnalysisCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ANALISI SESSIONE" Style="{StaticResource Small}" FontWeight="SemiBold" />
                    <TextBlock x:Name="AnalysisTitle" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="AnalysisMeta" Style="{StaticResource Small}" Margin="0,4,0,0" />

                    <ItemsControl x:Name="StatsGrid" Margin="0,14,-8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,8" Margin="0,0,8,8"
                                        ToolTip="{Binding Tip}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   Foreground="{Binding Brush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FPS durante la sessione" Style="{StaticResource CardTitle}" />
                            <perf:LineChart x:Name="SessionFpsChart" Height="200" Margin="0,10,0,0" Legend="FPS" Legend2="1% low" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CPU e GPU" Style="{StaticResource CardTitle}" />
                            <perf:LineChart x:Name="SessionLoadChart" Height="200" Margin="0,10,0,0" MinY="0" MaxY="100" ValueFormat="0'%'"
                                            Stroke="{StaticResource AccentBrush}" Stroke2="{StaticResource OkBrush}"
                                            Legend="CPU" Legend2="GPU" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,18,0,0">
                        <TextBlock x:Name="HistogramStatus" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center" />
                        <TextBlock Text="Distribuzione dei frametime" Style="{StaticResource CardTitle}"
                                   ToolTip="Quanti frame cadono in ogni intervallo di millisecondi: una «montagna» stretta significa gioco regolare, una coda lunga a destra significa scatti." />
                    </DockPanel>
                    <perf:Histogram x:Name="SessionHistogram" Height="180" Margin="0,10,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Confronta con" Style="{StaticResource Label}" Margin="0,0,12,0" />
                        <ComboBox x:Name="CompareCombo" Grid.Column="1" DisplayMemberPath="Title" SelectionChanged="CompareCombo_SelectionChanged" />
                    </Grid>
                    <TextBlock x:Name="CompareText" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

                    <TextBlock Text="Analisi automatica" Style="{StaticResource CardTitle}" Margin="0,18,0,10" />
                    <TextBlock x:Name="InsightsLoading" Style="{StaticResource Muted}" Text="Analisi in corso…" Visibility="Collapsed" />
                    <ItemsControl x:Name="SessionInsights" ItemTemplate="{StaticResource InsightTemplate}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
