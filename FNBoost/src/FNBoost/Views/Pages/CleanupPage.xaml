<UserControl x:Class="FNBoost.Views.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Pulizia" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                       Text="Elimina solo file temporanei, log e report di errore. I file in uso vengono saltati. Nessuna cartella di sistema viene toccata." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="AnalyzeBtn" Content="Analizza" Click="Analyze_Click" />
                <Button x:Name="CleanBtn" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="Clean_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="Pulisci selezionati" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ResultText" Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Warning}" Style="{StaticResource Small}" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0"
                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Label}" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Top" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
