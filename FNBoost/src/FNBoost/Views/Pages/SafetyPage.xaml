<UserControl x:Class="FNBoost.Views.Pages.SafetyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FNBoost.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Sicurezza e backup" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                       Text="Tutto ciò che FN Boost cambia è registrato e annullabile. In più puoi creare un punto di ripristino di Windows." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Punto di ripristino di Windows" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,10"
                               Text="Richiede che la Protezione sistema sia attiva sul disco C:. Si ripristina da: Start › 'Crea un punto di ripristino' › Ripristino configurazione di sistema." />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RestorePointBtn" Content="Crea punto di ripristino ora" Click="RestorePoint_Click" />
                        <TextBlock x:Name="RestorePointText" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Name="AutoRpBox" Margin="0,12,0,0" Content="Crealo automaticamente prima di applicare il primo tweak di ogni sessione"
                              Click="Settings_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Ripristina tutto" Click="RevertAll_Click" />
                        <TextBlock Text="Modifiche attive di FN Boost" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,10"
                               Text="Per ognuna è salvato il valore originale (in %LOCALAPPDATA%\FNBoost\tweak-backups.json)." />
                    <ItemsControl x:Name="BackupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AppliedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                   Style="{StaticResource Small}" />
                                        <TextBlock Text="{Binding TweakTitle}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoBackupsText" Style="{StaticResource Small}" Text="Nessuna modifica attiva." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Preferenze" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="TrayBox" Content="Chiudendo la finestra, resta attivo nell'area di notifica (mirino e scorciatoie restano attivi)"
                              Click="Settings_Click" />
                    <CheckBox x:Name="StartFloatingBox" Margin="0,10,0,0" Content="Avvia direttamente in modalità flottante" Click="Settings_Click" />
                    <TextBlock x:Name="HotkeysText" Style="{StaticResource Small}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Scorciatoie da tastiera" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Funzionano ovunque, anche in gioco (RegisterHotKey di Windows: nessun hook della tastiera). Clicca una casella e premi la nuova combinazione: serve almeno Ctrl, Alt o Shift. Esc annulla, Backspace/Canc disattiva la scorciatoia. Poi premi Applica." />
                    <Grid x:Name="HotkeyGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,8">
                            <TextBlock Text="Mirino on/off" />
                            <TextBlock Style="{StaticResource Small}" Text="Mostra o nasconde il mirino sopra al gioco" />
                        </StackPanel>
                        <v:HotkeyBox x:Name="HkCrosshair" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" HotkeyChanged="Hotkey_Changed" />

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,8">
                            <TextBlock Text="Pannello flottante" />
                            <TextBlock Style="{StaticResource Small}" Text="Apre o nasconde il pannello compatto" />
                        </StackPanel>
                        <v:HotkeyBox x:Name="HkPanel" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" HotkeyChanged="Hotkey_Changed" />

                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,8">
                            <TextBlock Text="Overlay FPS" />
                            <TextBlock Style="{StaticResource Small}" Text="Mostra o nasconde il contatore FPS in gioco" />
                        </StackPanel>
                        <v:HotkeyBox x:Name="HkOverlay" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" HotkeyChanged="Hotkey_Changed" />

                        <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,8">
                            <TextBlock Text="Preset mirino successivo" />
                            <TextBlock Style="{StaticResource Small}" Text="Passa al preset seguente dell'elenco (il nome compare sotto al mirino)" TextWrapping="Wrap" />
                        </StackPanel>
                        <v:HotkeyBox x:Name="HkNextPreset" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" HotkeyChanged="Hotkey_Changed" />

                        <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Registra sessione" />
                            <TextBlock Style="{StaticResource Small}" Text="Avvia o ferma la registrazione delle prestazioni" />
                        </StackPanel>
                        <v:HotkeyBox x:Name="HkRecord" Grid.Row="4" Grid.Column="1" HotkeyChanged="Hotkey_Changed" />
                    </Grid>
                    <CheckBox x:Name="PresetBalloonBox" Margin="0,14,0,0" Click="PresetBalloon_Click"
                              Content="Notifica anche nell'area di notifica quando cambi preset con la scorciatoia" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="HotkeyApplyBtn" Style="{StaticResource AccentButton}" Content="Applica" Click="HotkeyApply_Click" />
                        <Button Content="Ripristina predefinite" Margin="8,0,0,0" Click="HotkeyDefaults_Click" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyResultText" Style="{StaticResource Small}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Aggiorna" Click="RefreshLog_Click" />
                            <Button Content="Apri cartella dati" Margin="8,0,0,0" Click="OpenData_Click" />
                        </StackPanel>
                        <TextBlock Text="Registro attività" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="LogBox" Margin="0,10,0,0" Height="220" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
