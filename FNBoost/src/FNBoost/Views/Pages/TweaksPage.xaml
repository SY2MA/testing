<UserControl x:Class="FNBoost.Views.Pages.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Tweak Windows" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                       Text="Solo tweak documentati e reversibili. Ogni interruttore salva il valore originale prima di modificarlo: spegnerlo lo ripristina esattamente com'era. Passa il mouse su un tweak per vedere la chiave di registro modificata." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ApplyBtn" Style="{StaticResource AccentButton}" Content="Applica tutti i consigliati" Click="Apply_Click" />
            <Button x:Name="RevertBtn" Content="Ripristina modifiche FN Boost" Margin="10,0,0,0" Click="Revert_Click" />
            <Button x:Name="RefreshBtn" Content="Aggiorna stato" Margin="10,0,0,0" Click="Refresh_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List" Margin="0,0,16,24">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10" ToolTip="{Binding Technical}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="#267C5CFF"
                                                Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Consigliato" Style="{StaticResource BadgeText}" Foreground="#B7A6FF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextBrush}" Opacity="0.88" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Small}" Margin="0,6,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding ImpactText}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="#26F2B84B"
                                                Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Richiede riavvio" Style="{StaticResource BadgeText}" Foreground="{StaticResource WarnBrush}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CurrentValue}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Opacity="0.8" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding NotApplicableReason}" Style="{StaticResource Small}" Margin="0,6,0,0"
                                               Foreground="{StaticResource WarnBrush}"
                                               Visibility="{Binding NotApplicableReason, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="110">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center"
                                              IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                              Click="Toggle_Click" />
                                    <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"
                                               Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock Text="in corso…" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Accent2Brush}"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
