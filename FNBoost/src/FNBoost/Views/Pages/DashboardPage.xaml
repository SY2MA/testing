<UserControl x:Class="FNBoost.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Panoramica" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                       Text="Analisi del tuo PC e dei punti che influenzano FPS, stabilità dei frametime e stutter in Fortnite." />

            <!-- Hero -->
            <Border CornerRadius="14" Background="{StaticResource HeroGradient}" Padding="24" Margin="0,0,0,16"
                    BorderBrush="#333C5CFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Profilo Fortnite consigliato" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeroText" Style="{StaticResource Muted}" Margin="0,6,0,0" Foreground="#C9D3E6" MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   Text="Applica in un clic solo i tweak sicuri e consigliati. Prima viene creato un punto di ripristino e ogni valore originale viene salvato." />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="ApplyBtn" Style="{StaticResource AccentButton}" Click="Apply_Click" Padding="18,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" />
                                    <TextBlock Text="Applica consigliati" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RevertBtn" Content="Ripristina tutto" Margin="10,0,0,0" Click="Revert_Click" Padding="16,9" />
                            <Button x:Name="RefreshBtn" Margin="10,0,0,0" Click="Refresh_Click" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Text="Rianalizza" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,8,0">
                        <TextBlock x:Name="ScoreText" Text="–" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Accent2Brush}" />
                        <TextBlock Text="consigliati attivi" Style="{StaticResource Small}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hardware -->
            <UniformGrid x:Name="HwGrid" Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="SISTEMA" Style="{StaticResource Small}" FontWeight="SemiBold" />
                        <TextBlock x:Name="OsText" Text="…" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock x:Name="BoardText" Style="{StaticResource Small}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="PROCESSORE" Style="{StaticResource Small}" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuText" Text="…" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuDetail" Style="{StaticResource Small}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SCHEDA VIDEO" Style="{StaticResource Small}" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuText" Text="…" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuDetail" Style="{StaticResource Small}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="MEMORIA" Style="{StaticResource Small}" FontWeight="SemiBold" />
                        <TextBlock x:Name="RamText" Text="…" Margin="0,6,0,0" FontWeight="SemiBold" />
                        <TextBlock x:Name="RamDetail" Style="{StaticResource Small}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="MONITOR" Style="{StaticResource Small}" FontWeight="SemiBold" />
                        <TextBlock x:Name="DisplayText" Text="…" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="FORTNITE" Style="{StaticResource Small}" FontWeight="SemiBold" />
                        <TextBlock x:Name="FnText" Text="…" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock x:Name="FnDetail" Style="{StaticResource Small}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Controlli" Style="{StaticResource H2}" />
            <TextBlock x:Name="LoadingText" Style="{StaticResource Muted}" Text="Analisi in corso…" />
            <ItemsControl x:Name="ChecksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}}" Opacity="0.18" />
                                <TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="Bold" Width="26" TextAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextBrush}" Opacity="0.9" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Small}" Margin="0,4,0,0"
                                               Visibility="{Binding Hint, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ultima sessione registrata (modulo Prestazioni) -->
            <Border x:Name="LastSessionCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,8,0,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top" Background="{StaticResource Accent2Brush}" Opacity="0.18" />
                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="13" Width="26" TextAlignment="Center"
                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0" Foreground="{StaticResource Accent2Brush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="LastSessionTitle" Text="Ultima sessione registrata" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="LastSessionText" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.9" TextWrapping="Wrap" />
                        <TextBlock x:Name="LastSessionCompare" Style="{StaticResource Small}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Apri Prestazioni" VerticalAlignment="Center" Margin="12,0,0,0"
                            Click="OpenPerformance_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
